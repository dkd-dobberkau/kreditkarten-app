# Anthropic API Key für AI-Kategorisierung und Beleg-Erkennung
ANTHROPIC_API_KEY=sk-ant-api03-...

# Encryption Key für sensible Daten (Kartennummern)
# Generieren mit: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Optionale Konfiguration
DATA_DIR=./data
EXPORTS_DIR=./exports

# Claude-Modell für AI-Features (Default: claude-sonnet-4-5-20250929)
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
